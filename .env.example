# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Base URL (for proxy or alternative endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Whisper Model Configuration (Optional)
# Options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# Local upload size limit in MB (optional; Docker Compose passes this through)
UPLOAD_MAX_MB=200

# ---------------------------------------------------------------------------
# yt-dlp Configuration (Optional)
# ---------------------------------------------------------------------------
# YouTube increasingly blocks unauthenticated requests from VPS/datacenter IPs
# with "Sign in to confirm you're not a bot" — which surfaces in the UI as
# "下载视频失败: ERROR: [download] Got error: timed out" or a similar download
# failure. If you see this, supply YouTube cookies via ONE of the options
# below. See the "YouTube bot-check (cookies)" section of the README for how
# to export cookies from your browser.

# Path to a Netscape-format cookies.txt exported from a logged-in browser.
# Mutually exclusive with YT_DLP_COOKIES_BROWSER; the file wins if both are set.
# YT_DLP_COOKIES_FILE=/data/cookies.txt

# Read cookies directly from a local browser profile (only works if a browser
# with a logged-in YouTube session is installed on the same host).
# Examples: "chrome", "firefox", "chrome:Default", "chrome:/path/to/profile"
# YT_DLP_COOKIES_BROWSER=chrome

# Network tuning for slow / flaky links (defaults are usually fine).
# YT_DLP_SOCKET_TIMEOUT=60
# YT_DLP_RETRIES=10
# YT_DLP_FRAGMENT_RETRIES=10

# yt-dlp's EJS JS-challenge solver. Required since yt-dlp 2026.x to download
# YouTube videos — YouTube's `n` parameter is generated by player.js, and
# yt-dlp uses a remote helper script + a local JS runtime (deno or node) to
# solve it. Without this, yt-dlp only sees storyboards and any format
# selection like `bestaudio/best` fails with:
#     ERROR: Requested format is not available
# Make sure a JS runtime is installed (the bundled Dockerfile installs deno).
# Default is "ejs:github" which downloads the solver from yt-dlp's GitHub
# release. Set to empty string to disable (only works if you've manually
# installed the solver bundle locally).
# YT_DLP_REMOTE_COMPONENTS=ejs:github
