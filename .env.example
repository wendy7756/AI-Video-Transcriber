# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Base URL (for proxy or alternative endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Whisper Model Configuration (Optional)
# Options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# Local upload size limit in MB (optional; Docker Compose passes this through)
UPLOAD_MAX_MB=200

# Optional: TwelveLabs Pegasus transcription backend
# When enabled, video URLs are transcribed natively by Pegasus (server-side,
# long-video support, no audio download). Falls back to subtitles/Whisper on error.
# Get a free API key at https://twelvelabs.io
USE_TWELVELABS=false
TWELVELABS_API_KEY=your_twelvelabs_api_key_here
# Optional: Pegasus model (pegasus1.5 by default)
TWELVELABS_MODEL=pegasus1.5
