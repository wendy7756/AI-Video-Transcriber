# OpenAI / OpenRouter API Configuration
# OpenRouter keys: https://openrouter.ai/keys
OPENAI_API_KEY=your_openrouter_api_key_here

# Default: OpenRouter (OpenAI-compatible)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Default model on OpenRouter (override with OPENAI_FAST_MODEL / OPENAI_ADVANCED_MODEL)
OPENAI_MODEL=google/gemini-2.0-flash-001

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Whisper Configuration (Optional)
# Model size: tiny, base, small, medium, large (overrides preset default)
WHISPER_MODEL_SIZE=base
# Whisper engine: auto | mlx-whisper | faster-whisper
# auto: Apple Silicon + mlx-whisper installed → mlx; otherwise faster-whisper
WHISPER_ENGINE=auto
# Speed preset: fast | balanced | quality
WHISPER_SPEED_PRESET=balanced
# Device for faster-whisper only: auto | cpu | cuda
WHISPER_DEVICE=auto
# Preload model on startup: true | false
WHISPER_PRELOAD=true

# Local upload size limit in MB (optional; Docker Compose passes this through)
UPLOAD_MAX_MB=200
