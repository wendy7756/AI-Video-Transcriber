{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Trans",
  "version": "0.1.0",
  "identifier": "ai.videotrans.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:8765",
    "beforeBuildCommand": "",
    "frontendDist": "../../static"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Video Trans",
        "width": 1180,
        "height": 860,
        "visible": false,
        "url": "/loading.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "project_root.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
